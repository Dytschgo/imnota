{
  "name": "imnota",
  "version": "0.2.8",
  "description": "Turn annotated screenshots into AI-ready context.",
  "private": true,
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "author": {
    "name": "Dytschgo",
    "email": "info@dylanferraro.ch"
  },
  "license": "MIT",
  "homepage": "https://github.com/Dytschgo/imnota",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dytschgo/imnota.git"
  },
  "bugs": {
    "url": "https://github.com/Dytschgo/imnota/issues"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.electron.build.json --watch\" \"wait-on http://127.0.0.1:5173 dist-electron/electron/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 node scripts/dev-electron.mjs\"",
    "build": "tsc -p tsconfig.electron.build.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && node --test \"scripts/*.test.mjs\"",
    "test:visual": "node scripts/visual-regression.mjs",
    "test:share-contract": "vitest run --config vitest.share.config.ts",
    "test:watch": "vitest",
    "release": "node scripts/release.mjs",
    "smoke": "node scripts/smoke.mjs",
    "package:linux": "tsc -p tsconfig.electron.build.json && vite build && electron-builder --linux --publish never",
    "package:win": "tsc -p tsconfig.electron.build.json && vite build && electron-builder --win --publish never",
    "package:mac": "tsc -p tsconfig.electron.build.json && vite build && electron-builder --mac --universal --publish never",
    "package:all": "tsc -p tsconfig.electron.build.json && vite build && electron-builder --linux --win --mac --publish never",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "test:platform": "vitest run --config vitest.platform.config.ts && node --test \"scripts/*.test.mjs\""
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "dompurify": "3.4.15",
    "electron-updater": "6.8.9",
    "jszip": "^3.10.1",
    "konva": "^10.0.3",
    "lucide-react": "^0.468.0",
    "marked": "15.0.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-konva": "^19.0.10",
    "zod": "^4.5.4",
    "zustand": "^5.0.3"
  },
  "optionalDependencies": {
    "@koromix/koffi-win32-arm64": "3.3.0",
    "@koromix/koffi-win32-x64": "3.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^25.0.1",
    "pngjs": "7.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "icon": "build/icon.png",
    "afterPack": "scripts/adhoc-sign.mjs",
    "appId": "com.dytschgo.imnota",
    "productName": "Imnota",
    "asar": true,
    "files": [
      "scripts/update-macos.sh",
      "build/icon.png",
      "dist/**/*",
      "dist-electron/electron/**/*",
      "dist-electron/src/shared/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signExecutable": false
    },
    "mac": {
      "minimumSystemVersion": "13.0.0",
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.graphics-design",
      "identity": null,
      "hardenedRuntime": false
    },
    "publish": {
      "provider": "github",
      "owner": "Dytschgo",
      "repo": "imnota",
      "releaseType": "release"
    }
  }
}
